NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ── FDA regulatory intelligence (migration 009) ──────────────────────────────
# Optional. openFDA works without a key at 1,000 requests per day per IP; a free
# api.data.gov key raises that to 120,000 per day. https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

# Required before import refusals, inspection classifications and warning
# letters can be ingested. FDA issues these through the OII Unified Logon —
# free, but not open: every request needs both headers.
# https://datadashboard.fda.gov/oii/api/index.htm
FDA_DATADASHBOARD_USER=
FDA_DATADASHBOARD_KEY=
