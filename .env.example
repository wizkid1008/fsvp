# ── Build scope ─────────────────────────────────────────────────────────────
# Inlined into the bundle at compile time. In Cloudflare Pages these belong in
# Settings → Variables and secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Runtime scope ───────────────────────────────────────────────────────────
# Read by server code WHEN A REQUEST ARRIVES. In Cloudflare Pages these belong
# in Settings → Bindings (type: Secret), NOT in Variables and secrets — a
# build-scope variable is undefined inside the Pages Function, and the failure
# reads as an opaque error digest on every page that queries across tenants.
# See docs/cloudflare-pages.md.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. openFDA works without a key at 1,000 requests per day per IP; a free
# api.data.gov key raises that to 120,000. https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

# Required before import refusals, inspection classifications and warning
# letters can be ingested. FDA issues these through the OII Unified Logon —
# free, but not open: every request needs both headers. Both or neither; one
# without the other is treated as absent, because a half-configured credential
# 401s at request time and an unhandled 401 looks like a clean supplier.
# https://datadashboard.fda.gov/oii/api/index.htm
FDA_DATADASHBOARD_USER=
FDA_DATADASHBOARD_KEY=

# ── Local tooling only ──────────────────────────────────────────────────────
# For Wrangler on your own machine. Not needed by the deployed project.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
